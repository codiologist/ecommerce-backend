// Prisma ORM 6.x (pinned). Do not upgrade to 7/8 without approval (requirements §1).
// All tables live in the `app` Postgres schema, which is NOT exposed by Supabase's Data API.
// The schema is selected with `?schema=app` on DATABASE_URL and DIRECT_URL (see .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Models are added per phase.

// ---------------------------------------------------------------------------
// Phase 1 — Auth & Users
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  /// Always stored lowercased + trimmed (normalised by the Zod schemas).
  email             String     @unique @db.VarChar(254)
  passwordHash      String
  name              String     @db.VarChar(100)
  phone             String?    @db.VarChar(20)
  role              Role       @default(CUSTOMER)
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  twoFactorSecret         TwoFactorSecret?
  auditLogs               AuditLog[]
  inventoryMovements      InventoryMovement[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

/// One row per refresh token. Rotation creates a new row in the same family (familyId);
/// reuse of a rotated token revokes the whole family (requirements §3).
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  familyId          String    @db.Uuid
  /// SHA-256 of the opaque refresh token. The token itself is never stored.
  tokenHash         String    @unique @db.Char(64)
  userAgent         String?   @db.VarChar(512)
  ip                String?   @db.VarChar(64)
  /// Absolute expiry of the family (set at login, kept on rotation).
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReason     String?   @db.VarChar(32)
  lastUsedAt        DateTime  @default(now())
  /// Last successful re-authentication (sensitive actions).
  reauthAt          DateTime?
  twoFactorVerified Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TwoFactorSecret {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @db.Uuid
  /// TOTP secret, AES-256-GCM encrypted with TOTP_ENCRYPTION_KEY.
  secretEncrypted  String
  /// null until the user confirms setup with a valid code.
  enabledAt        DateTime?
  /// Last accepted TOTP time step (replay protection).
  lastUsedTimeStep Int?
  /// SHA-256 hashes of the remaining single-use backup codes.
  backupCodeHashes String[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(64)
  targetType String?  @db.VarChar(64)
  targetId   String?  @db.VarChar(64)
  metadata   Json?
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(512)
  requestId  String?  @db.VarChar(128)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Phase 2 — Catalog
// Money is stored as integer minor units (e.g. poisha for BDT) - never floats (§6).
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AttributeType {
  SELECT
  COLOR
}

enum InventoryReason {
  RESTOCK
  ADJUSTMENT
  DAMAGE
  CORRECTION
  /// Set by order flows (Phase 5+)
  SALE
  RETURN
}

model Category {
  id             String    @id @default(uuid()) @db.Uuid
  parentId       String?   @db.Uuid
  name           String    @db.VarChar(120)
  slug           String    @unique @db.VarChar(140)
  description    String?   @db.VarChar(2000)
  imageUrl       String?   @db.VarChar(1024)
  imageKey       String?   @db.VarChar(255)
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  seoTitle       String?   @db.VarChar(70)
  seoDescription String?   @db.VarChar(160)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, sortOrder])
  @@index([isActive])
  @@index([deletedAt])
  @@index([createdAt])
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  description String?   @db.VarChar(2000)
  logoUrl     String?   @db.VarChar(1024)
  logoKey     String?   @db.VarChar(255)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@index([sortOrder])
  @@index([isActive])
  @@index([deletedAt])
  @@index([createdAt])
}

model Attribute {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @db.VarChar(60)
  slug      String        @unique @db.VarChar(80)
  type      AttributeType @default(SELECT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  values AttributeValue[]

  @@index([sortOrder])
}

model AttributeValue {
  id          String   @id @default(uuid()) @db.Uuid
  attributeId String   @db.Uuid
  value       String   @db.VarChar(60)
  slug        String   @db.VarChar(80)
  /// For COLOR attributes, e.g. "#1a2b3c"
  colorHex    String?  @db.VarChar(7)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attribute Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants  VariantAttributeValue[]

  @@unique([attributeId, slug])
  @@index([attributeId, sortOrder])
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  name             String        @db.VarChar(200)
  slug             String        @unique @db.VarChar(220)
  /// Sanitized HTML (sanitize-html on write). Safe to render.
  description      String?
  shortDescription String?       @db.VarChar(500)
  status           ProductStatus @default(DRAFT)
  categoryId       String?       @db.Uuid
  brandId          String?       @db.Uuid
  /// [{ "name": "Material", "value": "Cotton" }, ...]
  specifications   Json          @default("[]")
  seoTitle         String?       @db.VarChar(70)
  seoDescription   String?       @db.VarChar(160)
  isFeatured       Boolean       @default(false)
  publishedAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand    Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  images   ProductImage[]

  @@index([status, deletedAt])
  @@index([categoryId])
  @@index([brandId])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([publishedAt])
}

model ProductVariant {
  id                String    @id @default(uuid()) @db.Uuid
  productId         String    @db.Uuid
  sku               String    @unique @db.VarChar(64)
  /// Minor units (e.g. 125000 = ৳1,250.00)
  price             Int
  compareAtPrice    Int?
  stock             Int       @default(0)
  lowStockThreshold Int       @default(5)
  weightGrams       Int?
  isDefault         Boolean   @default(false)
  isActive          Boolean   @default(true)
  sortOrder         Int       @default(0)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues VariantAttributeValue[]
  images          ProductImage[]
  movements       InventoryMovement[]

  @@index([productId, sortOrder])
  @@index([stock])
  @@index([deletedAt])
}

model VariantAttributeValue {
  variantId        String   @db.Uuid
  attributeValueId String   @db.Uuid
  /// Denormalised so "one value per attribute per variant" can be a unique constraint.
  attributeId      String   @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeValueId])
  @@unique([variantId, attributeId])
  @@index([attributeValueId])
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  variantId  String?  @db.Uuid
  /// Storage provider key (Cloudinary public_id)
  storageKey String   @db.VarChar(255)
  url        String   @db.VarChar(1024)
  alt        String?  @db.VarChar(200)
  width      Int
  height     Int
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([variantId])
}

model InventoryMovement {
  id         String          @id @default(uuid()) @db.Uuid
  variantId  String          @db.Uuid
  delta      Int
  stockAfter Int
  reason     InventoryReason
  note       String?         @db.VarChar(500)
  actorId    String?         @db.Uuid
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([actorId])
  @@index([reason])
}
