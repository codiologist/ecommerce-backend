NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Comma-separated explicit origins (no wildcards)
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=localhost
# Number of proxy hops in front of the app (e.g. 1 for Cloudflare -> app, 2 for Cloudflare -> LB -> app)
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

# Supabase pooled connection (Supavisor, transaction mode, port 6543) - runtime
# e.g. postgresql://app_user.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&schema=app
DATABASE_URL=
# Supabase direct / session connection (port 5432) - prisma migrate only
# e.g. postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=app
DIRECT_URL=

# Redis (rate limits, login protection, 2FA challenges). Local: `npm run db:up` (docker-compose).
REDIS_URL=redis://127.0.0.1:63799/0

# ---- Auth (Phase 1) ----
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=ecommerce-backend
JWT_AUDIENCE=ecommerce-api
REFRESH_TOKEN_EXPIRES_DAYS=14
ADMIN_REFRESH_TOKEN_EXPIRES_HOURS=12
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CSRF_SECRET=
# 32 bytes as 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=Store
# Cloudflare Turnstile. Required in production. Empty in dev = CAPTCHA skipped (with a warning).
# Cloudflare test keys: secret 1x0000000000000000000000000000000AA always passes.
TURNSTILE_SECRET_KEY=
# Resend. Required in production. Empty in dev = emails are logged instead of sent.
MAIL_FROM=
RESEND_API_KEY=

# ---- Later phases ----
STORAGE_BUCKET=
PAYMENT_PROVIDER=

# Seed (npm run db:seed): SUPER_ADMIN account, password >= 14 chars.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
